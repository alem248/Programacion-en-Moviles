rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Forma válida del perfil editable: nombre (2 a 60) y foto en Base64.
    function perfilValido() {
      return (!('nombre' in request.resource.data)
              || request.resource.data.nombre == null
              || (request.resource.data.nombre is string
                  && request.resource.data.nombre.size() >= 2
                  && request.resource.data.nombre.size() <= 60))
        && (!('fotoBase64' in request.resource.data)
            || request.resource.data.fotoBase64 == null
            || (request.resource.data.fotoBase64 is string
                && request.resource.data.fotoBase64.size() <= 700000));
    }

    // El rol vive en el propio documento del usuario; solo así puede consultarse
    // sin dejar que un usuario normal se lo asigne a sí mismo.
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      allow get: if esDueno(uid);
      // Alta desde la app; admite también el merge inicial con nombre/foto
      // por si el documento todavía no existe cuando se guarda el perfil.
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasAll(['rol', 'correo'])
        && request.resource.data.keys().hasOnly(['rol', 'correo', 'nombre', 'fotoBase64'])
        && request.resource.data.rol == 'usuario'
        && request.resource.data.correo == request.auth.token.email
        && perfilValido();
      // El dueño solo cambia su nombre y su foto; el rol y el correo quedan
      // fuera para que nadie se autoasigne administración.
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'fotoBase64'])
        && perfilValido();
      allow list, delete: if false;

      match /conversaciones/{conversationId}/mensajes/{mensajeId} {
        allow get, list: if request.auth != null && request.auth.uid == uid;
        // La app guarda el mensaje del usuario y la respuesta que genera Gemini;
        // solo se aceptan campos válidos y nunca se permite editar ni borrar.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && conversationId == 'mentor'
          && request.resource.data.keys().hasOnly(['texto', 'rol', 'favorita', 'creadoEn'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 5000
          && request.resource.data.rol in ['usuario', 'mentora']
          && request.resource.data.favorita == false
          && request.resource.data.creadoEn == request.time;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.rol == 'mentora'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorita'])
          && request.resource.data.favorita is bool;
        allow delete: if false;
      }
    }

    // Panel de actividad diaria del mentor: los contadores se incrementan desde
    // cualquier cuenta autenticada y solo el administrador puede leerlos.
    match /actividad/{fecha} {
      allow get, list: if esAdmin();
      allow create, update: if autenticado()
        && fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.fecha == fecha
        && request.resource.data.keys().hasOnly(['fecha', 'mensajes', 'respuestas', 'favoritos', 'sesiones'])
        && (!('mensajes' in request.resource.data)
            || (request.resource.data.mensajes is int && request.resource.data.mensajes >= 0))
        && (!('respuestas' in request.resource.data)
            || (request.resource.data.respuestas is int && request.resource.data.respuestas >= 0))
        && (!('favoritos' in request.resource.data)
            || (request.resource.data.favoritos is int && request.resource.data.favoritos >= 0))
        && (!('sesiones' in request.resource.data)
            || (request.resource.data.sesiones is int && request.resource.data.sesiones >= 0));

      match /registros/{registroId} {
        allow get, list: if esAdmin();
        allow create: if autenticado()
          && request.resource.data.keys().hasOnly(['tipo', 'uid', 'detalle', 'creadoEn'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tipo in ['MENSAJE', 'RESPUESTA', 'FAVORITO', 'SESION']
          && request.resource.data.detalle is string
          && request.resource.data.detalle.size() <= 140
          && request.resource.data.creadoEn == request.time;
        allow update, delete: if false;
      }
    }

    // Capas PNG del personaje: las lee cualquier cuenta autenticada para
    // dibujar al mentora y solo el administrador puede asociarlas o quitarlas.
    match /configuraciones/{documento} {
      allow get, list: if autenticado();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['base', 'ojos', 'boca'])
        && (!('base' in request.resource.data)
            || request.resource.data.base == null
            || (request.resource.data.base is string && request.resource.data.base.size() <= 900000))
        && (!('ojos' in request.resource.data)
            || request.resource.data.ojos == null
            || (request.resource.data.ojos is string && request.resource.data.ojos.size() <= 900000))
        && (!('boca' in request.resource.data)
            || request.resource.data.boca == null
            || (request.resource.data.boca is string && request.resource.data.boca.size() <= 900000));
      allow delete: if false;

      // Una pieza por documento para no acercarse al límite de 1 MiB:
      // `configuraciones/personaje/capas/{clave}` guarda el PNG en Base64.
      // Se lee con cualquier cuenta autenticada y solo el administrador
      // asocia (base64 con texto) o restablece (base64 nulo) la pieza.
      match /capas/{clave} {
        allow get, list: if autenticado();
        allow create, update: if esAdmin()
          && clave.matches('[a-z]+(_[a-z]+)*')
          && request.resource.data.keys().hasOnly(['base64'])
          && (!('base64' in request.resource.data)
              || request.resource.data.base64 == null
              || (request.resource.data.base64 is string
                  && request.resource.data.base64.size() <= 900000));
        allow delete: if esAdmin();
      }
    }
  }
}
