rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rol', 'correo'])
        && request.resource.data.keys().hasAll(['rol', 'correo'])
        && request.resource.data.rol == 'usuario'
        && request.resource.data.correo == request.auth.token.email;
      allow list, update, delete: if false;

      match /conversaciones/{conversationId}/mensajes/{mensajeId} {
        allow get, list: if request.auth != null && request.auth.uid == uid;
        // La app guarda el mensaje del usuario y la respuesta que genera Gemini;
        // solo se aceptan campos válidos y nunca se permite editar ni borrar.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && conversationId == 'mentor'
          && request.resource.data.keys().hasOnly(['texto', 'rol', 'creadoEn'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 5000
          && request.resource.data.rol in ['usuario', 'mentora']
          && request.resource.data.creadoEn == request.time;
        allow update, delete: if false;
      }
    }
  }
}
